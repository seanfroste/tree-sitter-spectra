{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "spectra",
  "rules": {
    "source_file": {
      "type": "REPEAT",
      "content": {
        "type": "CHOICE",
        "members": [
          {
            "type": "SYMBOL",
            "name": "title_statement"
          },
          {
            "type": "SYMBOL",
            "name": "end_statement"
          },
          {
            "type": "SYMBOL",
            "name": "_newline"
          }
        ]
      }
    },
    "title_statement": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "name",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "PATTERN",
              "value": "[tT][iI][tT][lL][eE]"
            },
            "named": true,
            "value": "statement_name"
          }
        },
        {
          "type": "CHOICE",
          "members": [
            {
              "type": "FIELD",
              "name": "title",
              "content": {
                "type": "ALIAS",
                "content": {
                  "type": "TOKEN",
                  "content": {
                    "type": "PATTERN",
                    "value": "[^\\r\\n]+"
                  }
                },
                "named": true,
                "value": "title_text"
              }
            },
            {
              "type": "BLANK"
            }
          ]
        }
      ]
    },
    "end_statement": {
      "type": "FIELD",
      "name": "name",
      "content": {
        "type": "ALIAS",
        "content": {
          "type": "PATTERN",
          "value": "[eE][nN][dD]"
        },
        "named": true,
        "value": "statement_name"
      }
    },
    "_newline": {
      "type": "PATTERN",
      "value": "\\n"
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "[\\t \\r]"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}