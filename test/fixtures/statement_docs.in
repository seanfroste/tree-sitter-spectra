TITLE MOS Tr W/L=5/2
BIAS ENAME=PD VSTEP=0.5 NSTEP=5 NFNAME=PD1 FLOAT=N ERROR=1E-12
CONSTANT TEMPERATURE=300 EOX=3.9 TNO=(1E14 3.95E-4 1E16 1E-5)
CONVERGENCE VERROR=1E-6 FERROR=1E-6 CARRIER=-1 METHOD=Potential-Dominant-Gummel
DEFINE NAME=Size VALUE=(0.3 0.5 0.8 1.2 2.0) CHARACTER='size sweep'
DEPOSIT TYPE=N CHARGE=1E15 XMIN=5.5 YMIN=6 ZMIN=0.1 XMAX=6.5 YMAX=8.5 ZMAX=0.3
DOPE TYPE=P PROFILE=GAUSSIAN CMAX=2E15 MASK=POLYGON(0,0 5,0 5,5 0,5) TRIM=RECTANGLE(0 0 5 5)
ELECTRODE NAME=GATE VOLTAGE=PWL(0,0 1E-9,3.3) MASK=FILE(mask.gds,cell-1,8,3)
EXTRACT PARAMETER=VMAX FILE=extract-{%3.1f:@Width-1}.txt AXIS=-Z NAME=Peak
GRID RATIO=20 ZMIN=-0.1 ZMAX=20 SPACE=30
IF [@Cmax <= 5E16]
INSERT FILE=MOS-1.txt
ELSE
INTERFACE MATERIAL=OXIDE MATERIAL=SILICON QF=8E10 MASK=FILE(mask.txt,cis,1,3)
LIGHT LAMBDA=550 POWER=PULSE(0,0 1E-9,1) THETA=0 FILE=light.rtd
MODEL MOBILITY=Y BGNARROW=Y SRH=Y AUGER=Y FNCURRENT=E
NFERMI XMIN=2 YMIN=3 ZMIN=0 XMAX=5.5 YMAX=7.8 ZMAX=0.1 VOLTAGE=10 PATTERN=X+Y- NAME=drain
PFERMI XMIN=2 YMIN=3 ZMIN=0 XMAX=5.5 YMAX=7.8 ZMAX=0.1 VOLTAGE=-3 PATTERN=X-Y- NAME=source
REGION MATERIAL=LOCOS ZMIN=(-0.2 -0.1) ZMAX=(0.1 0.2) GR=FILE(rate.dat) SHAPE=POLYGON
RESTART FILE=MOS-Tr-1.save NEW_FERMI=Y ADD_IMPURITY=N
SAVE FILE=es-vsub-{@Vsub-10}.dat TYPE=DATA TSTEP=(0,5,10,15,20)
STRUCTURE XBOUNDARY=PERIODIC YBOUNDARY=MIRROR XMAX=10 YMAX=10 ZMAX=20 ZMIN=-0.08 CELL=TETRAHEDRON
SUBSTRATE TYPE=P CONCENTRATION=2E15 VOLTAGE=PWL(0,0 1E-7,-2 1E-6,0)
ENDIF
END
SAVE FILE=ignored-after-end.dat
