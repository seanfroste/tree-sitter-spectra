TITLE Crosstalk Analysis
define name=wl value=400 vstep=50 nstep=6
SUBS TYPE=P CONC=2E15, VSUB=0
GRID GRATE=1, XMI=0 XMA=10 SPACE=80
GRID GRATE=1, YMI=0 YMA=10 SPACE=80
GRID GRATE=1, ZMI=-0.4 ZMA=-0.05 SPACE=7
GRID GRATE=1, ZMI=-0.05 ZMA=0 SPACE=5
GRID GRATE=70, ZMI=0.0 ZMA=8 SPACE=30
STRUCT XBOUND=p, YBOUND=p, XMAX=10, YMAX=10, ZMAX=8, ZMIN=-0.4
light power=1e-3 lambda=@wl xmin=2.5 ymin=0.25 xmax=4.75 ymax=4.75
CONV ca=1
#MODEL IMPACT=Y MOBIL=P BGN=Y SRH=Y AUGER=Y
$ LOCOS-LB (Left Bottom)
REGION MATERIAL=LOCOS ZMIN=-0.2 ZMAX=0.2 BEAK=0.2 name=LOCOS
MASK=POLY(0.25,0.25 1.25,0.25 1.25,3.75 2.5,3.75 2.5,0.25 4.75,0.25
4.75,4.75 0.25,4.75)
$ LOCOS-RB (Right Bottom)
REGION MATERIAL=LOCOS ZMIN=-0.2 ZMAX=0.2 BEAK=0.2 name=LOCOS
MASK=POLY(0.25,0.25 1.25,0.25 1.25,3.75 2.5,3.75 2.5,0.25 4.75,0.25
4.75,4.75 0.25,4.75) XPLUS=5
$ LOCOS-LT (Left Top)
REGION MATERIAL=LOCOS ZMIN=-0.2 ZMAX=0.2 BEAK=0.2 name=LOCOS
MASK=POLY(0.25,0.25 1.25,0.25 1.25,3.75 2.5,3.75 2.5,0.25 4.75,0.25
4.75,4.75 0.25,4.75) YPLUS=5
$ LOCOS-RT (Right Top)
REGION MATERIAL=LOCOS ZMIN=-0.2 ZMAX=0.2 BEAK=0.2 name=LOCOS
MASK=POLY(0.25,0.25 1.25,0.25 1.25,3.75 2.5,3.75 2.5,0.25 4.75,0.25
4.75,4.75 0.25,4.75) XPLUS=5 YPLUS=5
$
$ DOPE and Gate Electrodes are omitted
$
* electrode-LB
ELEC XMI=3.5 YMI=2.5 XMA=3.5 YMA=2.5 ZMI=0.25 ZMA=0.25 V=1 name=pd-LB
ELEC XMI=0.75 YMI=4.25 XMA=0.75 YMA=4.25 ZMI=0 ZMA=0 V=3.3 name=fd-LB
ELEC XMI=0.75 YMI=2.875 XMA=0.75 YMA=2.875 ZMI=0 ZMA=0 V=3.3 name=dd-LB
ELEC XMI=0.75 YMI=2 XMA=0.75 YMA=2 ZMI=0 ZMA=0 V=3.3 name=dif-LB
ELEC XMI=0.75 YMI=0.625 XMA=0.75 YMA=0.625 ZMI=0 ZMA=0 V=3.3 name=out-LB
* electrode-RB
ELEC XMI=3.5 YMI=2.5 XMA=3.5 YMA=2.5 ZMI=0.25 ZMA=0.25 V=1 name=pd-RB XPLUS=5
ELEC XMI=0.75 YMI=4.25 XMA=0.75 YMA=4.25 ZMI=0 ZMA=0 V=3.3 name=fd-RB XPLUS=5
ELEC XMI=0.75 YMI=2.875 XMA=0.75 YMA=2.875 ZMI=0 ZMA=0 V=3.3 name=dd-RB XPLUS=5
ELEC XMI=0.75 YMI=2 XMA=0.75 YMA=2 ZMI=0 ZMA=0 V=3.3 name=dif-RB XPLUS=5
ELEC XMI=0.75 YMI=0.625 XMA=0.75 YMA=0.625 ZMI=0 ZMA=0 V=3.3 name=out-RB XPLUS=5
* electrode-LT
ELEC XMI=3.5 YMI=2.5 XMA=3.5 YMA=2.5 ZMI=0.25 ZMA=0.25 V=1 name=pd-LT YPLUS=5
ELEC XMI=0.75 YMI=4.25 XMA=0.75 YMA=4.25 ZMI=0 ZMA=0 V=3.3 name=fd-LT YPLUS=5
ELEC XMI=0.75 YMI=2.875 XMA=0.75 YMA=2.875 ZMI=0 ZMA=0 V=3.3 name=dd-LT YPLUS=5
ELEC XMI=0.75 YMI=2 XMA=0.75 YMA=2 ZMI=0 ZMA=0 V=3.3 name=dif-LT YPLUS=5
ELEC XMI=0.75 YMI=0.625 XMA=0.75 YMA=0.625 ZMI=0 ZMA=0 V=3.3 name=out-LT YPLUS=5
* electrode-RT
ELEC XMI=3.5 YMI=2.5 XMA=3.5 YMA=2.5 ZMI=0.25 ZMA=0.25 V=1 name=pd-RT XPLUS=5 YPLUS=5
ELEC XMI=0.75 YMI=4.25 XMA=0.75 YMA=4.25 ZMI=0 ZMA=0 V=3.3 name=fd-RT XPLUS=5 YPLUS=5
ELEC XMI=0.75 YMI=2.875 XMA=0.75 YMA=2.875 ZMI=0 ZMA=0 V=3.3 name=dd-RT XPLUS=5 YPLUS=5
ELEC XMI=0.75 YMI=2 XMA=0.75 YMA=2 ZMI=0 ZMA=0 V=3.3 name=dif-RT XPLUS=5 YPLUS=5
ELEC XMI=0.75 YMI=0.625 XMA=0.75 YMA=0.625 ZMI=0 ZMA=0 V=3.3 name=out-RT XPLUS=5 YPLUS=5
$ Fermi Level
$ substrate
NFERMI XMI=0, YMI=0, ZMI=0, XMA=10, YMA=10, ZMA=8, V=0
$ PD
NFERMI XMI=0 YMI=0.0 ZMI=0.0 XMA=10 YMA=10 ZMA=8.0 V=3.3
$ Drain
NFERMI XMI=2.25 YMI=0 ZMI=0 XMA=5 YMA=5 ZMA=1 V=1 NAME=NF-LB
NFERMI XMI=2.25 YMI=0 ZMI=0 XMA=5 YMA=5 ZMA=1 V=1 XPLUS=5 NAME=NF-RB
NFERMI XMI=2.25 YMI=0 ZMI=0 XMA=5 YMA=5 ZMA=1 V=1 YPLUS=5 NAME=NF-LT
NFERMI XMI=2.25 YMI=0 ZMI=0 XMA=5 YMA=5 ZMA=1 V=1 XPLUS=5 YPLUS=5 NAME=NF-RT
$ P-Fermi Level
PFERMI XMI=0, YMI=0, ZMI=0, XMA=10, YMA=10, ZMA=8, V=0
EXTRACT para=@wl para=nc ename=pd-LB para=nc ename=pd-RB para=nc ename=pd-LT
para=nc ename=pd-RT file=xtalk-all.nc
END
