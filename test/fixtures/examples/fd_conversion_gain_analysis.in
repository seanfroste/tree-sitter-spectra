TITLE FD Conversion Gain Analysis
define name=FNFD value=3.3 vstep=-0.1 nstep=30
SUBS TYPE=P CONC=2E15, VSUB=0
GRID GRATE=1, XMI=0 XMA=5 SPACE=40
GRID GRATE=1, YMI=0 YMA=5 SPACE=40
GRID GRATE=1, ZMI=-0.41 ZMA=-0.01 SPACE=8
GRID GRATE=1, ZMI=-0.01 ZMA=0 SPACE=5
GRID GRATE=50, ZMI=0.0 ZMA=8 SPACE=20
STRUCT XBOUND=P, YBOUND=P, XMAX=5.0, YMAX=5, ZMAX=8, ZMIN=-0.41
CONV ca=0
$ LOCOS
REGION MATERIAL=LOCOS ZMIN=-0.2 ZMAX=0.2 BEAK=0.2 name=LOCOS
MASK=POLY(0.25,0.25 1.25,0.25 1.25,3.75 2.5,3.75 2.5,0.25 4.75,0.25
4.75,4.75 0.25,4.75)
$ DOPE statements are omitted
$ GATES
ELEC XMI=1.75 YMI=3.5 XMA=2.5 YMA=5 ZMI=-0.41 ZMA=-0.008 name=READ V=0 LOCOS=Y
ELEC XMI=0 YMI=1 XMA=1.5 YMA=1.5 ZMI=-0.41 ZMA=-0.008 name=AMP V=0 LOCOS=Y
ELEC XMI=0 YMI=2 XMA=1.5 YMA=2.5 ZMI=-0.41 ZMA=-0.008 name=ROW V=0 LOCOS=Y
ELEC XMI=0 YMI=3.25 XMA=1.5 YMA=3.75 ZMI=-0.41 ZMA=-0.008 name=RESET LOCOS=Y
v=0
ELEC XMI=0.25 YMI=4.25 XMA=1.25 YMA=4.75 ZMI=-0.41 ZMA=-0.008 name=DUMMY V=0
$ Fermi Level
$ Drain
NFERMI XMI=0, YMI=0, ZMI=0, XMA=5, YMA=5, ZMA=8, V=3.3
$ FD
NFERMI XMI=0 YMI=3.5 ZMI=0.0 XMA=2.0 YMA=5 ZMA=2.0 V=@FNFD
$ P-Fermi Level
PFERMI XMI=0, YMI=0, ZMI=0, XMA=5.0, YMA=5, ZMA=8, V=0
*
EXTRACT para=nfermi xmin=0.75 ymin=4.25
para=Vmax xmax=2 ymin=3.5
para=barrier ymin=3 ymax=4.5 xmin=0.25 xmax=1.5 axis=-y
para=elec xmax=2 ymin=3.5 zmax=1 file=fd-1.ele
END
