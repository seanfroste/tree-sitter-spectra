TITLE Transfer Efficiency Simulation
SUBS TYPE=P CONC=2E15, VSUB=0
GRID GRATE=1, XMI=0, XMA=1.5 SPACE=1
GRID GRATE=.2, YMI=0, YMA=2.0 SPACE=4
GRID GRATE=5, YMI=2.0 YMA=4. SPACE=4
GRID GRATE=.2, YMI=4., YMA=6. SPACE=4
GRID GRATE=5, YMI=6.0 YMA=8 SPACE=4
GRID GRATE=1, ZMI=-.070, ZMA=0.0 SPACE=7
GRID GRATE=50, ZMI=0, ZMA=4 SPACE=20
STRUCT XBOUND=M, YBOUND=M, XMAX=1.50, YMAX=8.0, ZMAX=4, ZMIN=-0.07
CONV CA=2 VERROR=1E-4 FERROR=1E-4
     TIME=2E-10 STEP=20
SAVE FILE= trans-200p.save
REST FILE= trans-0.save

$ BC
DOPE TYPE=N XMI=0 YMI=0 XMA=1.5 YMA=8.
     PROF=GAUSS CM=1.5E17 XJ=0.400 CB=2E15 RP=0
$ ELECTRODES
ELEC XMI=0, YMI=0, XMA=1.5, YMA=2.00 ZMI=-0.07 ZMA=-0.07 V=-6
ELEC XMI=0, YMI=2.00, XMA=1.5, YMA=6.0 ZMI=-0.07 ZMA=-0.07 V=-3
ELEC XMI=0, YMI=6.00, XMA=1.5, YMA=8.00 ZMI=-0.07 ZMA=-0.07 V=0
$ Fermi Level
$ N-Fermi Level
NFERMI XMI=0, YMI=0, ZMI=0, XMA=1.50, YMA=8.0 ZMA=4, VF=15.
NFERMI XMI=0, YMI=3.0, ZMI=0, XMA=1.50, YMA=5.0 ZMA=4., VF=6.5
$ P-Fermi Level
PFERMI XMI=0, YMI=0, ZMI=0, XMA=1.50, YMA=8.0, ZMA=4 VF=0

EXTRACT para=time para=elec xmin=0
        xmax=1.5 ymin=0 ymax=5.8 zmin=0
        zmax=4 file= trans-200p.ele
END