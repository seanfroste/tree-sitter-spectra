TITLE 1D Simulation
SUBS TYPE=P CONC=2E15, VSUB=0
GRID GRATE=1, XMI=0, XMA=10 SPACE=1
GRID GRATE=1, YMI=0, YMA=10 SPACE=1
GRID GRATE=1, ZMI=-.100, ZMA=0.0 SPACE=10
GRID GRATE=10, ZMI=0, ZMA=4 SPACE=30
STRUCT XBOUND=M, YBOUND=M, XMAX=10, YMAX=10., ZMAX=4, ZMIN=-0.10
INTERFACE XMI=0 YMI=0 ZMIN=-0.01 ZMAX=1 XMA=10 YMA=10 QF=5E10
CONV CA=0 VERROR=1E-7 FERROR=1E-5
$ BC
DOPE TYPE=N XMI=0.0 YMI=0 XMA=10. YMA=10.
     PROF=GAUSS CM=1.200E17 XJ=0.400 CB=2E15 RP=0.
*
* electrode
ELEC XMI=0 YMI=0.00 ZMI=-.07 ZMA=-.07 XMA=10. YMA=10.0 V=0 NAME=GATE
$ Fermi Level
$ substrate
NFERMI XMI=0, YMI=0, ZMI=0, XMA=10, YMA=10. ZMA=4, VF=15
$ P-Fermi Level
PFERMI XMI=0, YMI=0, ZMI=0, XMA=10, YMA=10.0, ZMA=4 VF=0
BIAS ENAME=GATE VSTEP=-1 NSTEP=10
EXTRACT PARA=VE ENAME=GATE PARA=VMAX FILE=vg-vm1d.vm
END