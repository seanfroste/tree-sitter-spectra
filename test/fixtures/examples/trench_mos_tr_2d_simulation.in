TITLE Trench MOS-Tr 2D Simulation
SUBS TYPE=P CONC=2E15, VSUB=0
GRID GRATE=.125, XMI=0 XMA=1.5 SPACE=10
GRID GRATE=8, XMI=1.5 XMA=2.5 SPACE=10
GRID GRATE=.125, XMI=2.5 XMA=3.5 SPACE=10
GRID GRATE=8, XMI=3.5 XMA=5.0 SPACE=10
GRID GRATE=1, YMI=0.0 YMA=1.0 SPACE=1
GRID GRATE=1, ZMI=-0.09 ZMA=0 SPACE=1
GRID GRATE=10, ZMI=0.0 ZMA=1 SPACE=10
GRID GRATE=.1, ZMI=1.0 ZMA=2 SPACE=10
GRID GRATE=10, ZMI=2.0 ZMA=5 SPACE=20
STRUCT XBOUND=M, YBOUND=M, XMAX=5.0, YMAX=1.0, ZMAX=5, ZMIN=-0.09
REGION XMI=1.5 YMI=0 ZMI=0 XMA=3.5 YMA=1. ZMA=2 MATE=OXI
CONV VERROR=1E-5, FERROR=1.E-5 CA=2
MODEL IMPACT=Y MOBIL=Y BGN=Y SRH=Y AUGER=Y
SAVE FILE= trench1.save
*REST FILE= trench1.save
$ S/D N+
DOPE TYPE=N XMI=0.0, YMI=0.00, XMA=1.50 YMA=1.0
     PROF=GAUSS CM=1.22B19 XJ=0.40 CB=1E15 RP=0.
DOPE TYPE=N XMI=3.5, YMI=0.00, XMA=5.0 YMA=1.0
     PROF=GAUSS CM=1.22B19 XJ=0.40 CB=1E15 RP=0
*
* electrode
*
ELEC XMI=1.6 YMI=.0 ZMI=0 XMA=3.4 YMA=1.0 ZMA=1.9 VE=2.0 NAME=GATE
ELEC XMI=0.0 YMI=.0 ZMI=0.1 XMA=0.0 YMA=1.0 ZMA=0.1 VE=0.0 NAME=SOURCE
ELEC XMI=5. YMI=0.0 ZMI=0.1 XMA=5.0 YMA=1.0 ZMA=0.1 VE=5.0 NAME=DRAIN
$ Fermi Level
$ substrate
NFERMI XMI=0, YMI=0, ZMI=0, XMA=5, YMA=1, ZMA=5, VF=0
$ DRAIN
NFERMI XMI=3.5 YMI=0.0 ZMI=0.0 XMA=5.0 YMA=1.0 ZMA=0.5 VF=5.0
$ P-Fermi Level
PFERMI XMI=0, YMI=0, ZMI=0, XMA=10.0, YMA=1.0, ZMA=20, VF=0
END