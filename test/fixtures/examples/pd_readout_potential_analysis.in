TITLE PD Readout Potential Analysis
define name=alpha value=0 vstep=0.2 nstep=5
define name=delta value=0 vstep=0.05 nstep=10
SUBS TYPE=P CONC=2E15, VSUB=0
GRID GRATE=1, XMI=0 XMA=5 SPACE=100
GRID GRATE=1, YMI=0 YMA=5 SPACE=100
GRID GRATE=1, ZMI=-0.41 ZMA=-0.01 SPACE=8
GRID GRATE=1, ZMI=-0.01 ZMA=0 SPACE=5
GRID GRATE=50, ZMI=0.0 ZMA=8 SPACE=20
STRUCT XBOUND=P, YBOUND=P, XMAX=5.0, YMAX=5, ZMAX=8, ZMIN=-0.41
CONV ca=0
SAVE FILE=tread-{@alpha}-{@delta}.dat type=data
$ LOCOS
REGION MATERIAL=LOCOS ZMIN=-0.2 ZMAX=0.2 BEAK=0.2 name=LOCOS
MASK=POLY(0.25,0.25 1.25,0.25 1.25,3.75 2.5,3.75 2.5,0.25 4.75,0.25
4.75,4.75 0.25,4.75)
$ DOPE
DOPE TYPE=P PROF=GAUSS CM=2E18 XJ=0.15 CB=1E15 RP=0 name=PDP
MASK=POLY(2.5,0.25 4.75,0.25 4.75,4.75 {2.5+@alpha+@delta},4.75
{2.5+@alpha+@delta},{3-@delta} 2.5,{3-@delta})
DOPE TYPE=N PROF=GAUSS CM=1.0E17 XJ=0.4 CB=1E15 RP=0.15 name=PD
MASK=POLY(2.5,0.25 4.75,0.25 4.75,4.75 {2.5+@alpha},4.75 {2.5+@alpha},3
2.5,3)
DOPE TYPE=N PROF=GAUSS CM=1E19 XJ=0.15 CB=2E15 RP=0 name=FD
xmin=0.25 xmax={1.75+@alpha} ymin=3.75 ymax=4.75
DOPE TYPE=N PROF=GAUSS CM=1E17 XJ=0.4 CB=1E15 RP=0.15 name=DFD
xmin=0.25 xmax={1.75+@alpha} ymin=3.75 ymax=4.75
DOPE TYPE=N XMI=0.25, YMI=2.5, XMA=1.25 YMA=3.25 name=DD
PROF=GAUSS CM=1E19 XJ=0.15 CB=2E15 RP=0
DOPE TYPE=N XMI=0.25, YMI=1.5, XMA=1.25 YMA=2 name=DIF
PROF=GAUSS CM=1E19 XJ=0.15 CB=2E15 RP=0
DOPE TYPE=N XMI=0.25, YMI=0.25, XMA=1.25 YMA=1 name=OUT
PROF=GAUSS CM=1E19 XJ=0.15 CB=2E15 RP=0
DOPE TYPE=P PROF=GAUSS CM=1.E17 XJ=0.70 CB=1E15 RP=0 name=CS
mask=poly(0,0 5,0 5,0.25 2.5,0.25 2.5,3.75 1.25,3.75 1.25,0.25 0,0.25)
DOPE TYPE=P PROF=GAUSS CM=1.E17 XJ=0.70 CB=1E15 RP=0 name=CS
mask=poly(0,0.25 0.25,0.25 0.25,4.75 4.75,4.75 4.75,0.25 5,0.25 5,5 0,5)
$ GATES
ELEC ZMI=-0.4 ZMA=-0.008 name=READ V=2.0 LOCOS=Y
mask=poly(1.75,3.75 1.75,3 {2.5+@alpha},3 {2.5+@alpha},5 {1.75+@alpha},5
{1.75+@alpha},3.75)
ELEC XMI=0 YMI=1 XMA=1.5 YMA=1.5 ZMI=-0.4 ZMA=-0.008 name=AMP V=0 LOCOS=Y
ELEC XMI=0 YMI=2 XMA=1.5 YMA=2.5 ZMI=-0.4 ZMA=-0.008 name=ROW V=0 LOCOS=Y
ELEC XMI=0 YMI=3.25 XMA=1.5 YMA=3.75 ZMI=-0.4 ZMA=-0.008 name=RESET V=0 LOCOS=Y
ELEC XMI=0.25 YMI=4.25 XMA=1.25 YMA=4.75 ZMI=-0.4 ZMA=-0.008 name=DUMMY V=0
$ Fermi Level
NFERMI XMI=0, YMI=0, ZMI=0, XMA=5, YMA=5, ZMA=8, V=3.3
PFERMI XMI=0, YMI=0, ZMI=0, XMA=5, YMA=5, ZMA=8, V=0
END
