TITLE PD Readout Transient Analysis
SUBS TYPE=P CONC=2E15, VSUB=0
GRID GRATE=1, XMI=0 XMA=5 SPACE=40
GRID GRATE=1, YMI=0 YMA=5 SPACE=40
GRID GRATE=1, ZMI=-0.4 ZMA=-0.05 SPACE=7
GRID GRATE=1, ZMI=-0.05 ZMA=0 SPACE=5
GRID GRATE=70, ZMI=0.0 ZMA=10 SPACE=20
STRUCT XBOUND=P, YBOUND=P, XMAX=5.0, YMAX=5, ZMAX=8, ZMIN=-0.4
CONV ca=2 time=1e-6 step=50 trate=1e5
SAVE FILE=read-1.0-1u.save
$ LOCOS
REGION MATERIAL=LOCOS ZMIN=-0.2 ZMAX=0.2 BEAK=0.2 name=LOCOS
MASK=POLY(0.25,0.25 1.25,0.25 1.25,3.75 2.5,3.75 2.5,0.25 4.75,0.25
4.75,4.75 0.25,4.75)
$
$ DOPE statements are omitted
$
$ GATES
ELEC XMI=1.75 YMI=3.5 XMA=2.5 YMA=5 ZMI=-0.4 ZMA=-0.05 name=READ LOCOS=Y
V=pwl(0,0 1E-12,3.3)
ELEC XMI=0 YMI=1 XMA=1.5 YMA=1.5 ZMI=-0.4 ZMA=-0.05 name=AMP V=0 LOCOS=Y
ELEC XMI=0 YMI=2 XMA=1.5 YMA=2.5 ZMI=-0.4 ZMA=-0.05 name=ROW V=0 LOCOS=Y
ELEC XMI=0 YMI=3.25 XMA=1.5 YMA=3.75 ZMI=-0.4 ZMA=-0.05 name=RESET V=0 LOCOS=Y
* bulk electrode
ELEC XMI=0.75 YMI=2.875 XMA=0.75 YMA=2.875 ZMI=0 ZMA=0 V=3.3 name=dd
$ Fermi Level
$ Drain
NFERMI XMI=0, YMI=0, ZMI=0, XMA=5, YMA=5, ZMA=8, V=3.3
$ PD
NFERMI XMI=2.25 YMI=0.0 ZMI=0.0 XMA=5.0 YMA=5 ZMA=2.0 V=0.2
$ P-Fermi Level
PFERMI XMI=0, YMI=0, ZMI=0, XMA=5.0, YMA=5, ZMA=8, V=0
*
EXTRACT para=time para=nfermi xmin=3.5 para=Vmax xmin=2.5
para=barrier xmin=1 xmax=5 axis=-x
para=elec xmin=2.5 zmax=1 file=read-1.0-1u.ele
END
