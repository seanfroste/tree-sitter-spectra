TITLE 1/2" 400K 3D Simulation
SUBS TYPE=N CONC=4B14, VSUB=15
GRID GRATE=1, XMI=0, XMA=8.4 SPACE=21
GRID GRATE=1, YMI=0, YMA=9.8 SPACE=20
GRID GRATE=1, ZMI=-.070, ZMA=0.0 SPACE=7
GRID GRATE=10, ZMI=0, ZMA=8. SPACE=26
GRID GRATE=1, ZMI=8.0, ZMA=15 SPACE=7
LIGHT POWER=1E-2 LAMBDA=550 XMI=5.0 YMI=1.5
      XMA=7.0 YMA=9.8 THETA=0
STRUCT XBOUND=P, YBOUND=P, XMAX=8.40, YMAX=9.8
       ZMAX=15, ZMIN=-0.09
CONV CA=0
$ PWELL
DOPE TYPE=P XMI=0 YMI=0 XMA=8.40 YMA=9.8
     PROF=GAUSS CM=*** XJ=*** CB=*** RP=***
$ BC
DOPE TYPE=N XMI=.5 YMI=0 XMA=2.5 YMA=9.8
     PROF=GAUSS CM=*** XJ=*** CB=*** RP=***
$ Hi-C
DOPE TYPE=P XMI=.5 YMI=0 XMA=2.5 YMA=9.8
     PROF=GAUSS CM=*** XJ=*** CB=*** RP=***
$ Photodiode N+
DOPE TYPE=N XMI=4.0 YMI=1.50 XMA=8.0 YMA=9.8
     PROF=GAUSS CM=*** XJ=*** CB=*** RP=***
$ BPD
DOPE TYPE=P XMI=4.0 YMI=1.50 XMA=8.40 YMA=9.8
     PROF=GAUSS CM=*** XJ=*** CB=*** RP=***
$ TG
DOPE TYPE=P XMI=2.5 YMI=0.00 XMA=8.40 YMA=9.8
     PROF=GAUSS CM=*** XJ=*** CB=*** RP=***
$ CS
DOPE TYPE=P XMI=0.0 YMI=0 XMA=8.5 YMA=9.8
     PROF=GAUSS CM=*** XJ=*** CB=*** RP=***
DOPE TYPE=P XMI=8.0 YMI=0 XMA=8.4 YMA=9.8
     PROF=GAUSS CM=*** XJ=*** CB=*** RP=***
DOPE TYPE=P XMI=2.5 YMI=0 XMA=4.0 YMA=5.
     PROF=GAUSS CM=*** XJ=*** CB=*** RP=***
DOPE TYPE=P XMI=4.0 YMI=0 XMA=8.00 YMA=1.5
     PROF=GAUSS CM=*** XJ=*** CB=*** RP=***
$ ELECTRODES
ELEC XMI=0 YMI=0.00 XMA=4.0 YMA=4.90
     ZMI=-0.09 ZMA=-0.09 V=0
ELEC XMI=4.00 YMI=0 XMA=8.40 YMA=1.50
     ZMI=-0.09 ZMA=-0.09 V=0
ELEC XMI=0 YMI=4.90 XMA=4.0 YMA=9.80
     ZMI=-0.09 ZMA=-0.09 V=0
$ Fermi Level
$ substrate
NFERMI XMI=0, YMI=0, ZMI=0, XMA=8.40
       YMA=9.8, ZMA=15, V=15
$ Buried channel
NFERMI XMI=0.25, YMI=0, ZMI=0, XMA=3.30
       YMA=9.8, ZMA=2.00, V=20.0
$ Photo Diode
NFERMI XMI=3.30, YMI=0, ZMI=0, XMA=8.40
       YMA=9.8, ZMA=2.00, V=20.0
NFERMI XMI=0.00, YMI=0, ZMI=0, XMA=0.25
       YMA=9.8, ZMA=2.00, V=20.0
$ P-Fermi Level
PFERMI XMI=0, YMI=0, ZMI=0, XMA=8.40
       YMA=9.80, ZMA=15, V=0
END